    {
      "x-register": "provisional_codes",
      "x-finding": {
        "code": "PROVISIONAL_CODE_ALREADY_BOUND",
        "intent": "a provisional code names what to build, never where it will live",
        "detail": "{token!r} in {column!r} — a provisional code carrying a namespace has already been placed, and placement is Stage 7's decision"
