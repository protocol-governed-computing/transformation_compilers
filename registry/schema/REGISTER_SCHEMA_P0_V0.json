  "allOf": [
    {
      "x-register": "system_beliefs",
      "x-finding": {
        "code": "BELIEF_CARRIES_CERTAINTY",
        "intent": "the truth/belief split is what P2 verification depends on",
        "detail": "beliefs must not carry a Certainty column — that would make them facts"
      },
      "items": {
        "not": {
          "required": [
            "certainty"
          ]
        }
      },
      "x-columns": {
        "certainty": "Certainty"
      }
    },
    {
      "x-register": "system_beliefs",
      "x-finding": {
        "code": "BELIEF_WITHOUT_VERIFICATION_GOAL",
        "intent": "an unverifiable belief silently becomes an assumption",
        "detail": "every belief must state what P2 has to establish"
      },
      "items": {
        "properties": {
          "verification_goal": {
            "minLength": 1
          }
        }
      }
    },
    {
      "x-register": "system_beliefs",
      "x-finding": {
        "code": "BELIEF_STATED_AS_FACT",
        "intent": "P0 must not promote a System Belief to a Known Fact",
        "detail": "belief is asserted, not suspected ({token!r}) — state it as a belief or move it to Known Facts"
      },
      "items": {
        "properties": {
          "belief": {
            "not": {
              "pattern": "(?i)^(?:there is|there are|the system provides|the system has|it is confirmed|confirmed:)(?=\\s)"
            }
          }
        }
      }
    },
    {
      "x-finding": {
        "code": "REGISTER_CELL_UNRESOLVED",
        "intent": "an unanswered question left in a register reads as decided to every later phase",
        "detail": "{column!r} declares the question unanswered ({marker}) rather than answering it — ask it as a clarification, do not hedge it in a register"
      },
      "x-realises": "lifecycle::INVARIANT_NO_QUESTION_LEFT_OPEN_V0",
      "x-procedure": {
        "name": "UNRESOLVED_MARKER_ABSENT",
        "params": {
          "exempt": [
            "clarification_requests"
          ],
          "detail": "{column!r} declares the question unanswered ({marker}) rather than answering it — ask it as a clarification, do not hedge it in a register"
        }
      }
    },
    {
      "x-register": "clarification_requests",
      "x-finding": {
        "code": "BLOCKING_CLARIFICATION_OUTSTANDING",
        "intent": "a blocking question the next phase never sees is answered by invention",
        "detail": "a blocking clarification is unanswered — resolve it with the named owner and fold the answer into the document before any phase consumes it"
      },
      "x-realises": "lifecycle::INVARIANT_NO_QUESTION_LEFT_OPEN_V0",
      "items": {
        "not": {
          "properties": {
            "blocking": {
              "const": "YES"
            }
          },
          "required": [
            "blocking"
          ]
        }
      }
    },
    {
      "x-register": "clarification_requests",
      "x-finding": {
        "code": "BUSINESS_CLARIFICATION_OUTSTANDING",
        "intent": "a business question that outlives the seed is answered downstream by inference",
        "detail": "only the business can answer this — ask it, fold the answer into the problem statement, and re-author the seed rather than carrying the question forward"
      },
      "x-realises": "lifecycle::INVARIANT_NO_QUESTION_LEFT_OPEN_V0",
      "items": {
        "not": {
          "properties": {
            "owner": {
              "const": "HUMAN"
            }
          },
          "required": [
            "owner"
          ]
        }
      }
    }
